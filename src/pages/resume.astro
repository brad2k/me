---
import {
  ChevronDown,
  Download,
  Info,
  Mail,
  SquareArrowOutUpRight,
  X,
} from "@lucide/astro";
import { Font, Image } from "astro:assets";
import { getCollection } from "astro:content";
import GitHub from "../assets/github-logo.svg";
import LinkedIn from "../assets/linkedin-logo.svg";
import Page from "../components/Page.astro";
import Badge from "../components/ui/Badge.astro";
import Scale from "../components/ui/Scale.astro";
import resume from "../data/resume.json";

const year = new Date().getFullYear();
const timespan = year - 2006;

const projectsUnsorted = await getCollection("projects");
const projects = projectsUnsorted.sort((a, b) => a.data.order - b.data.order);
---

<Page
  pageTitle="Resume | Brad Azevedo"
  pageDescription={`Resume for Brad Azevedo, front-end engineer and UI architect for more than ${timespan} years.`}
  class="resume"
>
  <Font cssVariable="--font-Fira" preload slot="head" />

  <header class="flow">
    <h1><span class="visually-hidden">Resume of </span> Brad Azevedo</h1>

    <section id="connect">
      <h2 class="visually-hidden">Connect with me</h2>
      <ul class="contacts">
        <li>
          <Mail />
          <a
            href="mailto:brad2k@gmail.com?subject=Howdy!"
            rel="external noopener"
          >
            <span class="contact--label">Email</span>
            <span class="contact--content">brad2k@gmail.com</span>
          </a>
        </li>
        <li>
          <LinkedIn />
          <a
            href="https://www.linkedin.com/in/bradazevedo"
            rel="external noopener"
            target="_blank"
          >
            <span class="contact--label">LinkedIn</span>
            <span class="contact--content">/in/bradazevedo</span>
            <span class="visually-hidden">, opens in new tab</span>
          </a>
        </li>
        <li>
          <GitHub />
          <a
            href="https://github.com/brad2k"
            rel="external noopener"
            target="_blank"
          >
            <span class="contact--label">GitHub</span>
            <span class="contact--content">/brad2k</span>
            <span class="visually-hidden">, opens in new tab</span>
          </a>
        </li>
        <li class="contact--download">
          <Download />
          <button popovertarget="resume-dialog">Download as a PDF</button>
        </li>
      </ul>
      <dialog
        id="resume-dialog"
        class="resume-dialog flow"
        popover
        aria-labelledby="resume-dialog-heading"
      >
        <h3 class="h5" id="resume-dialog-heading">Download my resume</h3>
        <p>
          Choose your format: a <a
            href="https://docs.google.com/document/d/1hkDlGxA0yBoNzVlyHzfJIruPoFcHOgrlE4PBoy8zrMI/export?format=pdf"
            rel="external noopener"
            target="_blank">standard one-page resume</a
          >, or this <a href="/brad-azevedo-resume.pdf" target="_blank" download
            >more informative, styled page</a
          > as a PDF.
        </p>
      </dialog>
    </section>

    <p class="summary">
      Front-end/design engineer with {timespan} years of experience on a journey spanning
      from IE6 to AI-assisted development. Specializing in the front of the front-end.
      Think: responsive UI architecture &amp; development, design systems, and generally{
        " "
      }
      <em>snazzy</em> UX. Also: I’m an instrument-rated private pilot.
    </p>
  </header>

  <section class="resume-section" id="experience">
    <h2><span class="visually-hidden">Experience </span>Timeline</h2>

    {
      resume.timeline.map((job) => {
        return (
          <article class="job flow">
            <dl class="highlight">
              <div class="dt-block">
                <dt>{job.company}</dt>
                <dd>
                  <time>{job.dates}</time>
                </dd>
                {job.title && <dd>{job.title}</dd>}
                {job.city && <dd>{job.city}</dd>}
              </div>
            </dl>

            <ul class="bullets">
              {job.bullets.map((thing) => (
                <li>{thing}</li>
              ))}
            </ul>

            <details class="editorial">
              <summary>
                <ChevronDown />
                <span>Behind the bullet points</span>
              </summary>

              <Fragment set:html={job.editorial} />
            </details>
          </article>
        );
      })
    }
  </section>

  <section class="resume-section" id="projects">
    <h2>Projects</h2>

    <p class="subtle">These are some projects I’ve worked on recently.</p>

    <ul class="grid project-grid">
      {
        projects.map((project) => (
          <li>
            <h3 class="visually-hidden">{project.data.title}</h3>
            <figure>
              <Image
                src={project.data.logo.image}
                alt={project.data.logo.alt}
              />

              <figcaption>
                <span>{project.data.title}: </span>
                {project.data.summary}
              </figcaption>
            </figure>

            <div>
              <ul class="project-badges">
                {project.data.badges.map((badge) => (
                  <li>
                    <Badge>{badge}</Badge>
                  </li>
                ))}
              </ul>
            </div>

            <div class="ctas">
              <span>View:</span>
              {project.data.url && (
                <>
                  <a
                    href={project.data.url}
                    target="_blank"
                    rel="external noopener"
                  >
                    <SquareArrowOutUpRight />
                    Project
                    <span class="visually-hidden">, opens in new tab</span>
                  </a>
                  <span aria-hidden="true">|</span>
                </>
              )}
              <button
                type="button"
                class="project-trigger"
                data-project={project.id}
              >
                <Info />
                Details
              </button>
            </div>
          </li>
        ))
      }
    </ul>

    <dialog
      id="project-dialog"
      class="project-dialog"
      aria-labelledby="project-dialog-heading"
    >
      <header class="project-dialog-header">
        <form method="dialog">
          <button><X /><span class="visually-hidden">Close</span></button>
        </form>
      </header>
      <div id="project-dialog-content" class="project-dialog-content flow">
      </div>
      <p id="project-dialog-status" class="visually-hidden" role="status"></p>
      <nav aria-label="Project navigation" class="project-dialog-nav">
        <button id="project-dialog-prev" disabled>Prev</button>
        <button id="project-dialog-next" disabled>Next</button>
      </nav>
    </dialog>

    {
      projects.map((project, index) => (
        <template
          id={`project-${project.id}`}
          data-prev={projects[index - 1] && projects[index - 1].id}
          data-next={projects[index + 1] && projects[index + 1].id}
        >
          <h3 id="project-dialog-heading">{project.data.title}</h3>
          <div>
            <ul class="project-badges">
              {project.data.badges &&
                project.data.badges.map((badge) => (
                  <li>
                    <Badge>{badge}</Badge>
                  </li>
                ))}
              {project.data.repo && (
                <li class="repo-link">
                  <a
                    href={project.data.repo}
                    target="_blank"
                    rel="external noopener"
                    title="View GitHub repo"
                    class="repo-link"
                  >
                    <GitHub />
                    <span class="visually-hidden">
                      View GitHub repo, opens in new tab
                    </span>
                  </a>
                </li>
              )}
            </ul>
          </div>

          <hr />

          <h4>Project brief</h4>
          <p>{project.data.brief || project.data.summary}</p>

          {project.data.scope && (
            <>
              <h4>Project scope</h4>
              <p>{project.data.scope}</p>
            </>
          )}
          {project.data.status && (
            <>
              <h4>Project status</h4>
              <p>{project.data.status}</p>
            </>
          )}

          <h4>Screenshots</h4>
          <ul class="project-gallery">
            {project.data.images.map((image) => (
              <li>
                <figure>
                  <Image src={image.image} alt={image.alt} />
                  {image.caption && <figcaption>{image.caption}</figcaption>}
                </figure>
              </li>
            ))}
          </ul>
        </template>
      ))
    }

    <script>
      const dialog =
        document.querySelector<HTMLDialogElement>("#project-dialog");
      const dialogContent = document.querySelector<HTMLDivElement>(
        "#project-dialog-content",
      );
      const navNext = document.querySelector<HTMLButtonElement>(
        "#project-dialog-next",
      );
      const navPrev = document.querySelector<HTMLButtonElement>(
        "#project-dialog-prev",
      );
      const statusRegion = document.querySelector<HTMLElement>(
        "#project-dialog-status",
      );

      function injectProject(e: MouseEvent) {
        const trigger = e.currentTarget as HTMLButtonElement;
        const template = document.querySelector<HTMLTemplateElement>(
          `#project-${trigger.dataset.project}`,
        );

        // Bail if we're missing some components
        if (!dialog || !dialogContent || !template || !navNext || !navPrev)
          return;

        // Is the user opening the dialog from the page or the internal nav?
        const isNavigating = dialog.open;

        dialogContent.replaceChildren(template.content.cloneNode(true));

        // Add/update next/prev projects as data attributes
        const prev = template.dataset.prev;
        if (prev) {
          navPrev.dataset.project = prev;
          navPrev.removeAttribute("disabled");
          navPrev.addEventListener("click", injectProject);
        } else {
          navPrev.setAttribute("disabled", "disabled");
          delete navPrev.dataset.project;
        }

        const next = template.dataset.next;
        if (next) {
          navNext.dataset.project = next;
          navNext.removeAttribute("disabled");
          navNext.addEventListener("click", injectProject);
        } else {
          navNext.setAttribute("disabled", "disabled");
          delete navNext.dataset.project;
        }

        // Updating the hidden status for aria-live region for accessibility
        if (isNavigating && statusRegion) {
          const heading = dialogContent.querySelector<HTMLHeadElement>(
            "#project-dialog-heading",
          )?.textContent;
          if (heading) statusRegion.textContent = `Showing project: ${heading}`;
        }

        dialog.showModal();
        dialog.scrollTop = 0;
        document.documentElement.classList.add("modal-open");
      }

      document
        .querySelectorAll<HTMLButtonElement>("[data-project]")
        .forEach((trigger) => {
          trigger.addEventListener("click", injectProject);
        });

      dialog?.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });

      dialog?.addEventListener("close", () => {
        document.documentElement.classList.remove("modal-open");
        navPrev?.removeEventListener("click", injectProject);
        navNext?.removeEventListener("click", injectProject);
      });
    </script>
  </section>

  <section class="resume-section" id="skills">
    <h2>Skills</h2>

    <div class="grid">
      <dl class="skill-list">
        <dt class="visually-hidden">Expert</dt>
        {
          resume.skills.expert.map((skill) => (
            <dd class="skill-wrapper">
              <Scale value={3} />
              <span set:html={skill} />
            </dd>
          ))
        }
      </dl>

      <dl class="skill-list">
        <dt class="visually-hidden">Proficient</dt>
        {
          resume.skills.proficient.map((skill) => (
            <dd class="skill-wrapper">
              <Scale value={2} />
              <span set:html={skill} />
            </dd>
          ))
        }
      </dl>

      <dl class="skill-list">
        <dt class="visually-hidden">Familiar</dt>
        {
          resume.skills.familiar.map((skill) => (
            <dd class="skill-wrapper">
              <Scale value={1} />
              <span set:html={skill} />
            </dd>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="resume-section" id="education">
    <h2>Education</h2>

    <dl class="highlight">
      {
        resume.education.map((knowledge) => {
          return (
            <div class="dt-block">
              <dt>{knowledge.highlight}</dt>
              <dd>
                <time datetime={knowledge.year.replace("—", "/")}>
                  {knowledge.year}
                </time>
              </dd>
              {knowledge.certification && <dd>{knowledge.certification}</dd>}
              {knowledge.city && <dd>{knowledge.city}</dd>}
            </div>
          );
        })
      }
    </dl>
  </section>

  <section class="resume-section" id="outside-of-work">
    <h2>Outside of work</h2>

    <p class="subtle">
      Summaries of academic and professional achievements are only one piece of
      the picture; our identities and professional value are equally informed by
      experiences in our personal lives. Head on over to the <a href="/about/"
        >About Me</a
      > page to learn more about what makes me tick.
    </p>
  </section>
</Page>

<style>
  .resume {
    font-family: var(--font-code);
  }

  .summary {
    --flow-space: var(--space-l);
    border-inline-start: 5px solid var(--color-accent);
    padding-inline-start: var(--gutter);
  }

  .contacts {
    --anchor-text-decoration: none;

    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-l);
    row-gap: var(--space-s);
    align-items: center;
    font-size: var(--font-size-subtle);
    line-height: var(--leading-flat);

    li {
      display: flex;
      align-items: center;
      gap: var(--space-xs);
      white-space: nowrap;
    }

    svg {
      height: 1em;
      width: 1em;
    }
  }

  .contact--content {
    display: none;
  }

  .contact--download {
    anchor-name: --resume-anchor;

    button:hover {
      color: var(--color-link-active);
    }
  }

  .dt-block {
    display: grid;
    gap: 0.25em; /* based on the root font size so it aligns with the "summary" paragraph */
    grid-template-columns: 1fr auto;
  }

  .highlight {
    display: grid;
    gap: var(--space-m);
    text-wrap: balance;
    line-height: var(--leading-fine);

    dt {
      font-weight: var(--font-weight-bold);
      font-size: var(--font-size-subtle);
    }

    dd {
      font-size: var(--font-size-small);

      &:nth-child(even) {
        place-self: end;
      }
    }
  }

  .job {
    --flow-space: var(--space-s);
  }

  .bullets {
    padding-inline-start: var(--space-s);
    list-style-type: disc;
    font-size: var(--font-size-small);
  }

  .resume-section {
    --flow-space: var(--space-xl);

    display: grid;
    gap: var(--space-l);

    h2 {
      padding-block-end: var(--space-xs);
      border-bottom: 1px solid var(--color-surface);
    }
  }

  .skill-wrapper {
    display: flex;
    align-items: center;
    gap: var(--space-s);
  }

  .editorial {
    font-size: var(--font-size-small);

    ::marker {
      content: "";
    }

    &::details-content {
      overflow: hidden;
      transition:
        block-size var(--transition-base),
        content-visibility var(--transition-base) allow-discrete;
      block-size: 0;
    }

    .lucide {
      height: 1.5em;
      width: 1.5em;
      transition: transform var(--transition-base);
    }

    summary {
      list-style-position: outside;
      line-height: var(--leading-flat);
      display: flex;
      align-items: center;
      gap: var(--space-xs);
      color: var(--color-accent);
      cursor: pointer;

      &:hover {
        font-weight: 500;
      }
    }

    p {
      padding-inline-start: var(--space-m);
      margin-block-start: var(--space-s);
    }

    &[open] {
      &::details-content {
        block-size: auto;
      }

      .lucide {
        transform: rotate(180deg);
      }
    }
  }

  .project-grid {
    --anchor-text-decoration: none;

    font-size: var(--font-size-small);

    li {
      display: grid;
      grid-row: span 3;
      grid-template-rows: subgrid;
      row-gap: var(--space-s);
    }

    figcaption {
      margin-block-start: var(--space-s);
    }

    img {
      border-radius: var(--radius-tight);
      aspect-ratio: 4 / 3;
    }
  }

  .project-badges {
    display: flex;
    gap: var(--space-s);
    flex-wrap: wrap;
  }

  .ctas {
    display: flex;
    align-items: center;
    gap: var(--space-s);

    & > * {
      display: flex;
      align-items: center;
      gap: var(--space-xs);
    }

    svg {
      width: 1em;
      height: 1em;
    }
  }

  .repo-link {
    display: grid;
    align-items: center;

    svg {
      width: 1em;
      height: 1em;
    }
  }

  .project-trigger {
    font-size: var(--font-size-small);

    &:hover {
      color: var(--color-link-active);
    }
  }

  .project-dialog {
    --flow-space: 1em;
    margin: auto;
    padding: 0;
    max-width: 50rem;
    max-height: calc(100dvh - (var(--space-m) * 2));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-base);
    background-color: var(--color-bg);
    color: var(--color-text);
    font-size: var(--font-size-small);

    &::backdrop {
      backdrop-filter: blur(1px);
      background-color: rgb(0 0 0 / 25%);
    }
  }

  .project-dialog-content {
    padding: 0 var(--space-l);
  }

  .project-dialog-header,
  .project-dialog-nav {
    padding-inline: var(--space-l);
    padding-block: var(--space-s);
    background-color: var(--color-bg);
  }

  .project-dialog-header {
    position: sticky;
    top: 0;
    line-height: 1;
    text-align: right;

    button {
      display: inline-block;

      &:hover {
        color: var(--color-link-active);
      }

      &:active {
        outline: 2px solid var(--focus-color, currentColor);
      }
    }
  }

  .project-dialog-nav {
    position: sticky;
    bottom: 0;
    display: flex;
    justify-content: space-between;
    gap: var(--space-m);
    margin-top: 2em;
    border-top: 1px solid var(--color-border);

    button {
      &:hover:not([disabled]) {
        color: var(--color-link-active);
      }
    }

    [disabled] {
      opacity: 0.5;
      cursor: not-allowed;
    }
  }

  .project-gallery {
    display: grid;
    gap: var(--space-l);

    figure {
      border-radius: var(--radius-tight);
      overflow: hidden;
    }

    figcaption {
      --prose-width: 100%;
      font-size: var(--font-size-small);
      padding: var(--space-s);
      background-color: var(--color-surface);
      border: 1px solid var(--color-border);
      border-top-width: 0;
    }
  }

  .resume-dialog {
    margin: 0;
    padding: var(--space-s);
    inset-inline: var(--space-m);
    top: calc(anchor(bottom) + var(--space-s));
    justify-self: anchor-center;
    position-anchor: --resume-anchor;
    max-height: calc(100dvh - (var(--space-m) * 2));
    position-try-fallbacks: flip-block;
    background-color: var(--color-bg);
    font-size: var(--font-size-small);

    &::backdrop {
      backdrop-filter: blur(1px);
      background-color: rgb(0 0 0 / 25%);
    }
  }

  @media print {
    :global(.primary-header, .footer),
    .editorial,
    #outside-of-work,
    .contact--label {
      display: none;
    }

    .contact--content {
      display: block;
    }

    .contact--download {
      display: none !important;
    }

    .project-grid {
      --grid-min-item-size: 10rem;
    }
  }
</style>
