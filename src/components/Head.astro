---
import { Font } from "astro:assets";
import OgImage from "../assets/brad-azevedo-og.jpg";
import Avatar from "../assets/brad-azevedo.jpg";

interface Props {
  pageDescription: string;
  pageTitle?: string;
}

const { pageDescription, pageTitle } = Astro.props;

const canonical = new URL(Astro.url.pathname.replace(/\/?$/, "/"), Astro.site);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Brad Azevedo",
  jobTitle: "Front-End/Design Engineer",
  url: "https://www.bradazevedo.com/",
  image: new URL(Avatar.src, Astro.site).href,
  description:
    "Self-taught front-end developer based in San Francisco specializing in UI architecture, design systems, and accessible web experiences.",
  address: {
    "@type": "PostalAddress",
    addressLocality: "San Francisco",
    addressRegion: "CA",
  },
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "San Francisco State University",
  },
  hasCredential: [
    {
      "@type": "EducationalOccupationalCredential",
      credentialCategory: "certificate",
      name: "Private Pilot Certificate, Airplane Single-Engine Land, with Instrument Rating",
    },
    {
      "@type": "EducationalOccupationalCredential",
      credentialCategory: "certificate",
      name: "FAA Ground Instructor Certificate, Advanced Rating",
    },
    {
      "@type": "EducationalOccupationalCredential",
      credentialCategory: "certificate",
      name: "FAA Ground Instructor Certificate, Instrument Rating",
    },
  ],
  knowsAbout: [
    "Front-end development",
    "Design systems",
    "UI architecture",
    "Web accessibility",
    "Web performance",
    "Web standards",
    "React",
    "TypeScript",
    "Astro",
    "Design tokens",
    "Figma",
  ],
  sameAs: [
    "https://www.instagram.com/bradazevedo/",
    "https://github.com/brad2k/",
    "https://www.linkedin.com/in/bradazevedo/",
  ],
};
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light dark" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={canonical} />
  <meta name="generator" content={Astro.generator} />

  <Font cssVariable="--font-Fraunces" />
  <Font cssVariable="--font-Epilogue" />
  <slot name="head" />

  <title>{pageTitle}</title>

  <meta name="description" content={pageDescription} />

  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:image" content={OgImage.src} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="600" />
  <meta property="og:image:type" content="image/jpeg" />

  <link rel="sitemap" href="/sitemap-index.xml" />

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(personSchema)}
  />
</head>
